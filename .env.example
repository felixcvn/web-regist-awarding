# Database Connection URL (PostgreSQL)
# Format: postgres://username:password@host:port/database?sslmode=require
# PRODUCTION: use a managed Postgres (Neon/Supabase/Railway). SSL is auto-enabled
# for non-localhost hosts. The local JSON-file fallback is DISABLED in production.
# All production instances must share this DB, including sessions and rate limits.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/fasilkom_awarding"

# Trusted ingress: vercel, cloudflare, reverse-proxy, or none.
# Leave empty to auto-select vercel only when VERCEL=1; otherwise IP is "unknown".
# reverse-proxy trusts only X-Real-IP; cloudflare trusts only CF-Connecting-IP.
# The chosen ingress MUST overwrite that header and block direct origin access.
# See SECURITY-DEPLOYMENT.md for upload limits and an Nginx example.
TRUSTED_PROXY=""

# Admin authentication
# Production REQUIRES ADMIN_PIN_HASH (bcrypt). Generate with:
#   npm run hash-pin -- "<pin-kuat>"
# IMPORTANT: in .env.local escape every "$" as "\$" (Next expands "$var"),
# but paste the raw hash WITHOUT escaping in the Vercel/hosting dashboard.
ADMIN_PIN_HASH=""

# Cloudflare Turnstile (opsional, sangat disarankan di produksi).
# Isi keduanya untuk mengaktifkan anti-bot pada form registrasi.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Gmail SMTP for sending QR invitation emails
# Use a Gmail App Password (https://myaccount.google.com/apppasswords), not the account password
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Public base URL, used to build ticket links in emails.
# PRODUCTION: REQUIRED — set to your deployed URL (e.g. https://fan2026.example.com).
# If unset on Vercel, VERCEL_URL is used automatically; otherwise falls back to localhost.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# QR image mode in invitation emails: "cid" (inline attachment, works everywhere incl. localhost)
# or "url" (hosted at /api/qr/<token>, requires a publicly reachable NEXT_PUBLIC_APP_URL)
QR_EMAIL_MODE="cid"
